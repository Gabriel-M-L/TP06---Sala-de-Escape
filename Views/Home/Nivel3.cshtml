@{
    ViewData["Title"] = "Nivel 3";
}

<div class="container level-shell">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <h1 class="level-title scanline-text">🔐🔐🔐 Nivel 3</h1>

            <div class="level-banner crt-frame">
                <img src="/imagenes/comodin/Odd_Todd.webp" alt="">
                <div>
                    <h2 class="mt-3 mb-2">El código de Odd Todd</h2>
                    <p class="text-muted">La puerta está protegida por un código. Las pistas están frente a vos, pero solo una combinación puede abrirla. Descubrí el código antes de que se acabe el tiempo.</p>
                </div>
            </div>

            <div class="card mb-4 level-card crt-frame">
                <div class="card-header">
                    <h5 class="mb-0">📝 Desafío</h5>
                </div>
                <div class="card-body">
                    <div class="level-prompt scanline-text consigna-html">@Html.Raw(ViewBag.Nivel.Desafio)</div>
                </div>
            </div>

            <form method="post" action="@Url.Action("VerificarRespuesta", "Home")">
                <input type="hidden" name="id" value="@ViewBag.Nivel.Id" />
                <div class="mb-3">
                    <label for="respuesta" class="form-label">Tu Respuesta:</label>
                    <input type="text" class="form-control form-control-lg" id="respuesta" name="respuesta" placeholder="Ingresa la respuesta..." required />
                </div>
                <button type="submit" class="btn btn-success btn-lg w-100">Enviar Respuesta</button>
            </form>

            <hr />

            <div class="mt-4">
                @if (ViewBag.Pistas > 0)
                {
                    <button class="btn btn-outline-light w-100" type="button" onclick="mostrarPista('pistaNivel3', this)">
                        💡 Mostrar pista
                    </button>
                }
                else
                {
                    <button class="btn btn-outline-light w-100" type="button" disabled>
                        💡 Mostrar pista
                    </button>
                    <small class="text-muted d-block mt-2">No te quedan pistas.</small>
                }
                <small class="text-muted d-block mt-2">Pistas disponibles: @ViewBag.Pistas</small>
                <div class="collapse mt-3" id="pistaNivel3">
                    <div class="card level-card level-hint-shell crt-frame">
                        <div class="card-header">
                            <h6 class="mb-0">💡 Pista</h6>
                        </div>
                        <div class="card-body">
                            <p>@ViewBag.Nivel.Pista</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <a href="@Url.Action("CerrarSesion", "Home")" class="btn btn-outline-light">Volver al Inicio</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function mostrarPista(pistaId, boton) {
            try {
                const response = await fetch('@Url.Action("UsarPista", "Home")', {
                    method: 'POST'
                });

                const data = await response.json();

                if (!data.success) {
                    alert(data.message || 'No te quedan pistas.');
                    return;
                }

                const elemento = document.getElementById(pistaId);
                if (elemento) {
                    const collapse = bootstrap.Collapse.getOrCreateInstance(elemento);
                    collapse.show();
                }

                if (boton) {
                    boton.disabled = true;
                    boton.textContent = data.remaining > 0
                        ? `💡 Pista mostrada (${data.remaining} restantes)`
                        : '💡 Pista mostrada';
                }
            } catch (error) {
                alert('No se pudo mostrar la pista.');
            }
        }

        document.querySelector('form').addEventListener('submit', function(e) {
            var respuesta = document.getElementById('respuesta').value.trim();
            if (!respuesta) {
                alert('Por favor ingresa una respuesta');
                e.preventDefault();
            }
        });
    </script>
}
