@{
    ViewData["Title"] = "Integrantes";
}

<section class="page-shell crt-frame">
    <div class="page-header">
        <span class="escape-badge">Equipo</span>
        <h1 class="escape-title">Integrantes del Equipo</h1>
    </div>

    <div class="team-card">
        <img src="/imagenes/comodin/Jimbo.webp" alt="Gabriel Martinez Loufer" class="team-photo" />

        <div class="team-body">
            <h2>Gabriel Martinez Loufer</h2>
            <p class="team-role">Desarrollador Principal</p>
            <ul class="team-list">
                <li>Responsable del backend y lógica del juego.</li>
                <li>Encargado del frontend e interfaz de usuario.</li>
                <li>Diseño y coherencia visual de la experiencia.</li>
            </ul>
        </div>
    </div>

    <div class="page-links">
        <a href="@Url.Action("Index", "Home")">Volver al inicio</a>
    </div>
</section>
