@{
    ViewData["Title"] = "Nivel 4";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <img src="/imagenes/comodin/Even_Steven.webp" alt="">

            <div class="card mb-4">
                <div class="card-header bg-dark text-white">
                    <h5>📝 Desafío</h5>
                </div>
                <div class="card-body">
                    <p class="lead level-prompt scanline-text">@Html.Raw(ViewBag.Nivel.Desafio)</p>
                </div>
            </div>

            <form method="post" action="@Url.Action("VerificarRespuesta", "Home")">
                <input type="hidden" name="id" value="@ViewBag.Nivel.Id"/>
                <div class="mb-3">
                    <label for="respuesta" class="form-label">Tu Respuesta:</label>
                    <input type="text" class="form-control form-control-lg" id="respuesta" name="respuesta" placeholder="Ingresa la respuesta..." required />
                </div>
                <button type="submit" class="btn btn-success btn-lg w-100">Enviar Respuesta Final</button>
            </form>

            <hr />
            <div class="mt-4">
                @if (ViewBag.Pistas > 0)
                {
                    <button class="btn btn-outline-secondary w-100" type="button" onclick="mostrarPista('pistaNivel4', this)">
                        💡 Mostrar pista
                    </button>
                }
                else
                {
                    <button class="btn btn-outline-secondary w-100" type="button" disabled>
                        💡 Mostrar pista
                    </button>
                    <small class="text-muted d-block mt-2">No te quedan pistas.</small>
                }
                <small class="text-muted d-block mt-2">Pistas disponibles: @ViewBag.Pistas</small>
                <div class="collapse mt-3" id="pistaNivel1">
                    <div class="card bg-light">
                        <div class="card-header bg-secondary text-white">
                            <h6 class="mb-0">💡 Pista</h6>
                        </div>
                        <div class="card-body">
                            <p>@ViewBag.Nivel.Pista</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <a href="@Url.Action("CerrarSesion", "Home")" class="btn btn-outline-secondary">Volver al Inicio</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function mostrarPista(pistaId, boton) {
            try {
                const response = await fetch('@Url.Action("UsarPista", "Home")', {
                    method: 'POST'
                });

                const data = await response.json();

                if (!data.success) {
                    alert(data.message || 'No te quedan pistas.');
                    return;
                }

                const elemento = document.getElementById(pistaId);
                if (elemento) {
                    const collapse = bootstrap.Collapse.getOrCreateInstance(elemento);
                    collapse.show();
                }

                if (boton) {
                    boton.disabled = true;
                    boton.textContent = data.remaining > 0
                        ? `💡 Pista mostrada (${data.remaining} restantes)`
                        : '💡 Pista mostrada';
                }
            } catch (error) {
                alert('No se pudo mostrar la pista.');
            }
        }

        document.querySelector('form').addEventListener('submit', function(e) {
            var respuesta = document.getElementById('respuesta').value.trim();
            if (!respuesta) {
                alert('Por favor ingresa una respuesta');
                e.preventDefault();
            }
        });
    </script>
}
