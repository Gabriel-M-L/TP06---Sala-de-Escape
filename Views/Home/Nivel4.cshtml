@{
    ViewData["Title"] = "Nivel 4";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="level-banner crt-frame">
                <img src="/imagenes/comodin/Even_Steven.webp" alt="">
                <div>
                    <h2 class="mt-3 mb-2">El juicio de Even Steven</h2>
                    <p class="text-muted">Mirá atentamente. Solo tendrás unos segundos para memorizar las cartas. Después desaparecerán y tendrás que responder. Una vez que empiece, no habrá vuelta atrás.</p>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-dark text-white">
                    <h5>📝 Desafío</h5>
                </div>
                <div class="card-body">
                    <div id="nivel4-aviso" class="alert alert-warning mb-4" role="alert" style="cursor:pointer;">
                        Preparáte: primero vas a ver las cartas por unos segundos. Después desaparecerán y recién ahí aparecerá la pregunta. </br>
                        <span class="hagaClick">HAGA CLICK AQUÍ PARA EMPEZAR.</span>
                    </div>
                    <div class="level-prompt scanline-text consigna-html">@Html.Raw(ViewBag.Nivel.Desafio)</div>
                </div>
            </div>

            <form action="@Url.Action("VerificarRespuesta4", "Home")" method="post" autocomplete="off">
                <div class="mb-3">
                    <input type="hidden" name="pistasUsadas" id="pistasUsadas" value="0" autocomplete="off"/>
                    <input type="hidden" name="respuestaCorrecta" value="@ViewBag.Nivel.Respuesta" autocomplete="off"/>
                    <label for="respuesta" class="form-label">Tu Respuesta:</label>
                    <input type="text" class="form-control form-control-lg" id="respuesta" name="respuesta" placeholder="Ingresa la respuesta..." required autocomplete="off" />
                </div>
                <button type="submit" class="btn btn-success btn-lg w-100">Enviar Respuesta</button>
            </form>

            <hr />

            <div class="mt-4">
                <small class="text-muted d-block mt-2">Pistas disponibles: @ViewBag.Pistas</small>
                <button class="btn btn-outline-light w-100" type="button" id="botonPista" onclick="mostrarPista(@ViewBag.Pistas)">
                    💡 Mostrar pista
                </button>
                <div class="collapse mt-3" id="bloquePista">
                    <div class="card level-card level-hint-shell crt-frame">
                        <div class="card-header">
                            <h6 class="mb-0">💡 Pista</h6>
                        </div>
                        <div class="card-body">
                            <p id="pista"></p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <a href="@Url.Action("CerrarSesion", "Home")" class="btn btn-outline-light">Volver al Inicio</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var aviso = document.getElementById('nivel4-aviso');
            var cartas = document.querySelector('.consigna-html .consigna-html-4');
            var preguntaYPistas = document.querySelectorAll('.consigna-html > p, .consigna-html > span');
            var secuenciaIniciada = false;
            var tiempoMemoria = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.TiempoMemoria ?? 5000));

            if (cartas) {
                cartas.style.display = 'none';
            }

            preguntaYPistas.forEach(function (elemento) {
                elemento.style.display = 'none';
            });

            if (aviso) {
                aviso.addEventListener('click', function () {
                    if (secuenciaIniciada) {
                        return;
                    }

                    secuenciaIniciada = true;
                    aviso.style.display = 'none';

                    if (cartas) {
                        cartas.style.display = 'block';
                    }

                    setTimeout(function () {
                        if (cartas) {
                            cartas.style.display = 'none';
                        }
                        preguntaYPistas.forEach(function (elemento) {
                            elemento.style.display = '';
                        });
                    }, tiempoMemoria);
                });
            }
        });
        function insertSymbol(sym) {
            var input = document.getElementById('respuesta');
            if (!input) return;
            input.value = (input.value || '') + sym;
            input.focus();
        }

        function decodeHtmlEntities(value) {
            const textarea = document.createElement('textarea');
            textarea.innerHTML = value;
            return textarea.value;
        }

        function mostrarPista(pistasDisponibles) {
            var pista = document.getElementById('pista');
            var pistasUsadas = document.getElementById('pistasUsadas');
            var bloquePista = document.getElementById('bloquePista');
            var botonPista = document.getElementById('botonPista');
            var textoPista = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Nivel.Pista));

            if (pistasDisponibles > 0) {
                pista.innerText = decodeHtmlEntities(textoPista);
                bloquePista.classList.add('show');
                bloquePista.style.display = 'block';
                pistasUsadas.value = parseInt(pistasUsadas.value) + 1;
                botonPista.disabled = true;
            } else {
                bloquePista.classList.add('show');
                bloquePista.style.display = 'block';
                botonPista.disabled = true;
                pista.innerText = "No hay más pistas disponibles.";
            }
        }
        document.querySelector('form').addEventListener('submit', function (e) {
            var respuesta = document.getElementById('respuesta').value.trim();
            if (!respuesta) {
                alert('Por favor ingresa una respuesta');
                e.preventDefault();
            }
        });
    </script>
}
