@{
    ViewData["Title"] = "Te quedaste sin intentos";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <h1>Oh oh... te quedaste sin intentos</h1>
            <hr />
            <div class="card mb-4">
                <div class="card-body">
                    <img src="@ViewBag.JimboImg" alt="Jimbo" class="img-fluid mb-3" style="max-height:240px;" />
                    <p class="lead">Te quedaste sin intentos en este nivel.</p>
                    <p>Si querés, podés intentar de nuevo, pero te voy a cobrar toda la plata que tenías como cuota de revivición.</p>
                    <p><strong>Plata actual: </strong>@ViewBag.Plata</p>
                </div>
            </div>

            <form method="post" action="@Url.Action("RevivirConfirmar", "Home")">
                <button type="submit" class="btn btn-danger btn-lg w-100">Pagar y Reintentar</button>
            </form>

            <div class="mt-3">
                <a href="@Url.Action("NivelActual", "Home")" class="btn btn-outline-secondary">Volver</a>
            </div>
        </div>
    </div>
</div>
